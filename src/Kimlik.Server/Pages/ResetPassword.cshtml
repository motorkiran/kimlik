@page "/reset-password"
@model ResetPasswordModel
@{
    ViewData["Title"] = L["Choose a new password"];
}

@if (Model.Completed)
{
    <h1 id="page-title">@L["Your password has been changed."]</h1>
    <p class="lead">@L["Sign in with your new password. For your security, your other sessions have been ended."]</p>
    <div class="actions">
        <a class="button" asp-page="/SignIn">@L["Sign in"]</a>
    </div>
}
else if (Model.LinkInvalid)
{
    <h1 id="page-title">@L["Choose a new password"]</h1>
    <div class="alert alert-error" role="alert">@L["This link is invalid or has expired."]</div>
    <div class="actions">
        <a class="button" asp-page="/ForgotPassword">@L["Request a new link"]</a>
    </div>
}
else
{
    <h1 id="page-title">@L["Choose a new password"]</h1>
    <partial name="_FormError" />
    <form method="post" novalidate>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <div class="field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="new-password" autofocus aria-describedby="password-hint" />
            <span id="password-hint" class="hint">@L["Use at least {0} characters.", Model.PasswordMinimumLength]</span>
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="button">@L["Change password"]</button>
    </form>
}
