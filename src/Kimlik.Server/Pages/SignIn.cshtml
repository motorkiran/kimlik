@page "/signin"
@using Kimlik.Server.Hosting
@model SignInModel
@{
    ViewData["Title"] = L["Sign in"];
}

<h1 id="page-title">@L["Sign in"]</h1>
<p class="lead">@L["Welcome back. Sign in to continue."]</p>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-error" role="alert">
        @Model.ErrorMessage
        @if (Model.ShowResendVerification)
        {
            <a asp-page="/ResendVerification" asp-route-returnUrl="@Model.ReturnUrl">@L["Send a new verification link"]</a>
        }
    </div>
}

<form method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Credential" />
    <input type="hidden" asp-for="State" />
    <div class="field">
        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username webauthn" autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
    </div>
    <div class="row">
        <label class="checkbox"><input asp-for="Input.RememberMe" /> @L["Keep me signed in"]</label>
        <a asp-page="/ForgotPassword">@L["Forgot password?"]</a>
    </div>
    <partial name="_Captcha" model="new[] { Kimlik.Server.Captcha.CaptchaForm.SignIn, Kimlik.Server.Captcha.CaptchaForm.SignInCode }" />
    <button type="submit" class="button">@L["Sign in"]</button>
    <button type="submit" class="button button-secondary" id="passkey-sign-in" formaction="@Url.Page("/SignIn", "Passkey")"
            data-passkey-sign-in data-autofill data-options="@Url.Page("/SignIn", "PasskeyOptions")" hidden>@L["Sign in with a passkey"]</button>
    @if (Model.CanUseEmailCode)
    {
        <button type="submit" class="button button-secondary" id="email-code" formaction="@Url.Page("/SignIn", "EmailCode")" formnovalidate>@L["Email me a sign-in code"]</button>
    }
    @if (Model.OffersSso)
    {
        <button type="submit" class="button button-secondary" id="sso-sign-in" formaction="@Url.Page("/SignIn", "Sso")" formnovalidate>@L["Sign in with SSO"]</button>
    }
    <p class="field-error" data-passkey-error hidden>@L["The passkey could not be used. Try again."]</p>
</form>

@if (Model.CanUsePhone)
{
    <p class="switch"><a asp-page="/SignInPhone" asp-route-returnUrl="@Model.ReturnUrl" id="phone-sign-in">@L["Sign in with a phone number"]</a></p>
}

<partial name="_ExternalSignIn" model="Model.ReturnUrl" />

@section Scripts {
    <script src="~/js/passkeys.js" asp-append-version="true" nonce="@HttpContext.GetCspNonce()" defer></script>
}

@if (Model.CanSignUp)
{
    <p class="switch">@L["New here?"] <a asp-page="/SignUp" asp-route-returnUrl="@Model.ReturnUrl">@L["Create an account"]</a></p>
}
