@page "/signup"
@model SignUpModel
@{
    ViewData["Title"] = L["Create an account"];
}

<h1 id="page-title">@L["Create an account"]</h1>

@if (!Model.CanSignUp)
{
    <p class="lead">@L["Registration is closed. Ask an administrator for an invitation."]</p>
    <div class="actions">
        <a class="button button-secondary" asp-page="/SignIn" asp-route-returnUrl="@Model.ReturnUrl">@L["Sign in"]</a>
    </div>
}
else
{
    <p class="lead">@L["It only takes a minute."]</p>

    <partial name="_FormError" />

    <form method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="Invitation" />
        <div class="field-pair">
            <div class="field">
                <label asp-for="Input.GivenName"></label>
                <input asp-for="Input.GivenName" autocomplete="given-name" />
                <span asp-validation-for="Input.GivenName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.FamilyName"></label>
                <input asp-for="Input.FamilyName" autocomplete="family-name" />
                <span asp-validation-for="Input.FamilyName" class="field-error"></span>
            </div>
        </div>
        <div class="field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="email" readonly="@(Model.InvitedEmail is not null)" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="new-password" aria-describedby="password-hint" />
            <span id="password-hint" class="hint">@L["Use at least {0} characters.", Model.PasswordMinimumLength]</span>
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <button type="submit" class="button">@L["Create account"]</button>
    </form>

    <partial name="_ExternalSignIn" model="Model.ReturnUrl" />
}

<p class="switch">@L["Already have an account?"] <a asp-page="/SignIn" asp-route-returnUrl="@Model.ReturnUrl">@L["Sign in"]</a></p>
