@page "/forgot-password"
@model ForgotPasswordModel
@{
    ViewData["Title"] = L["Reset your password"];
}

<h1 id="page-title">@L["Reset your password"]</h1>

@if (Model.Sent)
{
    <div class="alert alert-success" role="status">@L["If an account exists for that address, we sent a link to reset its password. The link expires in 1 hour."]</div>
    <div class="actions">
        <a class="button button-secondary" asp-page="/SignIn">@L["Back to sign in"]</a>
    </div>
}
else
{
    <p class="lead">@L["Enter the email address of your account and we will send you a link to choose a new password."]</p>
    <partial name="_FormError" />
    <form method="post" novalidate>
        <div class="field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="email" autofocus />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <button type="submit" class="button">@L["Send link"]</button>
    </form>
    <p class="switch"><a asp-page="/SignIn">@L["Back to sign in"]</a></p>
}
