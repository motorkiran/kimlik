@page "/signin/external/callback/{provider}"
@model SignInExternalCallbackModel
@{
    ViewData["Title"] = L["Sign in"];
}

<h1 id="page-title">@L["Sign in"]</h1>
<div class="alert alert-error" role="alert">
    @Model.ErrorMessage
    @if (Model.ShowResendVerification)
    {
        <a asp-page="/ResendVerification">@L["Send a new verification link"]</a>
    }
</div>
<div class="actions">
    <a class="button button-secondary" asp-page="/SignIn">@L["Back to sign in"]</a>
</div>
