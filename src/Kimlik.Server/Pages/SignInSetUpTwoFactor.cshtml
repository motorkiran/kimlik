@page "/signin/set-up-two-factor"
@model SignInSetUpTwoFactorModel
@{
    ViewData["Title"] = L["Set up two-factor authentication"];
}

@if (Model.RecoveryCodes is not null)
{
    <h1 id="page-title">@L["Save your recovery codes"]</h1>
    <p class="lead">@L["Two-factor authentication is on. If you lose your device, each of these codes signs you in once. Keep them somewhere safe; they are not shown again."]</p>
    <partial name="_RecoveryCodes" model="Model.RecoveryCodes" />
    <div class="actions">
        <a class="button" href="@Model.ContinueUrl">@L["Continue"]</a>
    </div>
}
else
{
    <h1 id="page-title">@L["Set up two-factor authentication"]</h1>
    <p class="lead">@L["Your account needs a second step at sign-in. Scan the code with an authenticator app, such as Google Authenticator or Microsoft Authenticator, then enter the code it shows."]</p>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-error" role="alert">@Model.ErrorMessage</div>
    }

    <partial name="_AuthenticatorKey" model="Model.Key" />

    <form method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Code"></label>
            <input asp-for="Code" autocomplete="one-time-code" inputmode="numeric" autofocus />
            <span asp-validation-for="Code" class="field-error"></span>
        </div>
        <button type="submit" class="button">@L["Turn on"]</button>
    </form>
}
