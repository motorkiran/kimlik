@page "/verify-email/resend"
@model ResendVerificationModel
@{
    ViewData["Title"] = L["Resend verification email"];
}

<h1 id="page-title">@L["Resend verification email"]</h1>

@if (Model.Sent)
{
    <div class="alert alert-success" role="status">@L["If an account with that address still needs confirming, we sent a new link."]</div>
    <div class="actions">
        <a class="button button-secondary" asp-page="/SignIn" asp-route-returnUrl="@Model.ReturnUrl">@L["Back to sign in"]</a>
    </div>
}
else
{
    <p class="lead">@L["Enter your email address and we will send you a new verification link."]</p>
    <partial name="_FormError" />
    <form method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" autocomplete="email" autofocus />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>
        <button type="submit" class="button">@L["Send link"]</button>
    </form>
}
