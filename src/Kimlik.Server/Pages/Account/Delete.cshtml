@page "/account/delete"
@model DeleteModel
@{
    ViewData["Title"] = L["Delete account"];
}

@if (Model.Deleted)
{
    <h1 id="page-title">@L["Your account has been deleted."]</h1>
    <p class="lead">@L["You have been signed out of every application."]</p>
    <div class="actions">
        <a class="button button-secondary" asp-page="/Index">@L["Go to the home page"]</a>
    </div>
}
else
{
    <p class="back"><a asp-page="/Account/Index">@L["Back to your account"]</a></p>
    <h1 id="page-title">@L["Delete account"]</h1>
    <p class="lead">@L["This deletes your account for good and signs you out of every application. It cannot be undone."]</p>
    <partial name="_FormError" />
    <form method="post" novalidate>
        @if (Model.HasPassword)
        {
            <div class="field">
                <label asp-for="Input.CurrentPassword"></label>
                <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
            </div>
        }
        else
        {
            <div class="field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" type="email" autocomplete="off" aria-describedby="email-hint" />
                <span id="email-hint" class="hint">@L["Type the email address of your account to confirm."]</span>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
        }
        <button type="submit" class="button button-danger">@L["Delete my account"]</button>
    </form>
}
