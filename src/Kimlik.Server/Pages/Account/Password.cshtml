@page "/account/password"
@model PasswordModel
@{
    ViewData["Title"] = L["Change password"];
}

<p class="back"><a asp-page="/Account/Index">@L["Back to your account"]</a></p>

@if (Model.Changed)
{
    <h1 id="page-title">@L["Your password has been changed."]</h1>
    <p class="lead">@L["For your security, your other sessions and applications have been signed out."]</p>
}
else
{
    <h1 id="page-title">@L["Change password"]</h1>
    <p class="lead">@L["You stay signed in here. Your other sessions and applications are signed out."]</p>
    <partial name="_FormError" />
    <form method="post" novalidate>
        <div class="field">
            <label asp-for="Input.CurrentPassword"></label>
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" autofocus />
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="new-password" aria-describedby="password-hint" />
            <span id="password-hint" class="hint">@L["Use at least {0} characters.", Model.PasswordMinimumLength]</span>
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="button">@L["Change password"]</button>
    </form>
}
