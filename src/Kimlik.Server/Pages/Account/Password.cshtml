@page "/account/password"
@model PasswordModel
@{
    ViewData["Title"] = L["Change password"];
}

<p class="back"><a asp-page="/Account/Index">@L["Back to your account"]</a></p>

@if (Model.Removed)
{
    <h1 id="page-title">@L["Your password has been removed."]</h1>
    <p class="lead">@L["From now on, sign in with a code sent to your email. Your other sessions and applications have been signed out."]</p>
}
else if (Model.Changed && !Model.HasPassword)
{
    <h1 id="page-title">@L["Your password has been set."]</h1>
    <p class="lead">@L["You can now sign in with your email address and password too."]</p>
}
else if (Model.Changed)
{
    <h1 id="page-title">@L["Your password has been changed."]</h1>
    <p class="lead">@L["For your security, your other sessions and applications have been signed out."]</p>
}
else
{
    @if (Model.HasPassword)
    {
        <h1 id="page-title">@L["Change password"]</h1>
        <p class="lead">@L["You stay signed in here. Your other sessions and applications are signed out."]</p>
    }
    else
    {
        <h1 id="page-title">@L["Set a password"]</h1>
        <p class="lead">@L["You sign in with an account at another provider. With a password, you can also sign in with your email address."]</p>
    }
    <partial name="_FormError" />
    <form method="post" novalidate>
        @if (Model.HasPassword)
        {
            <div class="field">
                <label asp-for="Input.CurrentPassword"></label>
                <input asp-for="Input.CurrentPassword" autocomplete="current-password" autofocus />
                <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
            </div>
        }
        <div class="field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="new-password" aria-describedby="password-hint" />
            <span id="password-hint" class="hint">@L["Use at least {0} characters.", Model.PasswordMinimumLength]</span>
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>
        <button type="submit" class="button">@(Model.HasPassword ? L["Change password"] : L["Set password"])</button>
    </form>

    @if (Model.CanRemove)
    {
        <section id="remove-password" class="section">
            <h2>@L["Remove your password"]</h2>
            <p class="hint">@L["Sign in with codes sent to your email instead. Your other sessions and applications are signed out."]</p>
            <form method="post" asp-page-handler="Remove" novalidate>
                <div class="field">
                    <label for="RemovePassword">@L["Current password"]</label>
                    <input type="password" id="RemovePassword" name="RemovePassword" autocomplete="current-password" />
                    <span asp-validation-for="RemovePassword" class="field-error"></span>
                </div>
                <button type="submit" class="button button-secondary">@L["Remove password"]</button>
            </form>
        </section>
    }
}
