{%- capture subject -%}You already have a {{ product.name }} account{%- endcapture -%}
{%- capture html -%}
<p>Hi{% if name %} {{ name }}{% endif %},</p>
<p>Someone, hopefully you, tried to create a {{ product.name }} account with this email address. You already have one.</p>
<p style="margin:28px 0;"><a href="{{ link }}" style="display:inline-block;padding:12px 20px;background:{{ product.color }};color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;">Sign in</a></p>
<p style="color:#6b7280;font-size:13px;">Forgot your password? You can reset it from the sign-in page. If this was not you, no action is needed.</p>
{%- endcapture -%}
