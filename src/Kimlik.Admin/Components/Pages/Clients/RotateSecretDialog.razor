@* Asks how long the current secret keeps working once a new one is issued. *@
<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">The client needs the new secret to get tokens. Keeping the current one working for a while lets it switch without downtime.</MudText>
        <MudSelect T="int" @bind-Value="_days" Label="The current secret keeps working" id="keep-previous">
            <MudSelectItem T="int" Value="0">Not at all; it stops at once</MudSelectItem>
            <MudSelectItem T="int" Value="1">For a day</MudSelectItem>
            <MudSelectItem T="int" Value="7">For a week</MudSelectItem>
            <MudSelectItem T="int" Value="30">For 30 days</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="() => Dialog.Close(DialogResult.Ok(_days))" id="issue-secret">Issue</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private int _days;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;
}
