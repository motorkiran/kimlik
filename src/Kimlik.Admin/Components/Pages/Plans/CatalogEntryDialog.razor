@* A key, a name and a description, as plans and features have. *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_key" Label="Key" Required MaxLength="64" HelperText="Lowercase letters, digits and _, such as export_pdf. Tokens and code use it." />
        <MudTextField @bind-Value="_name" Label="Name" Required MaxLength="100" />
        <MudTextField @bind-Value="_description" Label="Description" MaxLength="256" />
        @if (AskType)
        {
            <MudSelect T="FeatureType" @bind-Value="_type" Label="Type">
                <MudSelectItem T="FeatureType" Value="FeatureType.Boolean">On or off</MudSelectItem>
                <MudSelectItem T="FeatureType" Value="FeatureType.Limit">Limit</MudSelectItem>
            </MudSelect>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(_key) || string.IsNullOrWhiteSpace(_name)"
                   OnClick="() => Dialog.Close(DialogResult.Ok(new Entry(_key.Trim(), _name.Trim(), _description, _type)))">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _key = string.Empty;
    private string _name = string.Empty;
    private string? _description;
    private FeatureType _type = FeatureType.Boolean;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter]
    public bool AskType { get; set; }

    public sealed record Entry(string Key, string Name, string? Description, FeatureType Type);
}
