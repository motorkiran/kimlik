@page "/admin/users/{Id:guid}"
@using Kimlik.Application.ApiKeys
@using Kimlik.Application.Mfa
@using Kimlik.Application.Roles
@using Kimlik.Application.Users
@using Kimlik.Contracts.Account
@using Kimlik.Domain.Common
@inherits AdminPageBase

<PageTitle>@(_user?.Email ?? "User") · Kimlik admin</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0" />

@if (_notFound)
{
    <MudText Typo="Typo.h4" HtmlTag="h1">User not found</MudText>
    <MudText>The user does not exist; perhaps they were deleted.</MudText>
}
else if (_user is { } user)
{
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-6" Wrap="Wrap.Wrap">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">@user.Email</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Created <Moment Value="user.CreatedAt" />, last signed in <Moment Value="user.LastSignInAt" />
            </MudText>
        </div>
        <MudSpacer />
        <MudButton Href="@($"/admin/users/{Id}/export")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Class="mr-3"
                   id="export-data">Export personal data</MudButton>
        <UserStatusChip User="user" />
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined>
                <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>Profile</MudText>
                <MudTextField @bind-Value="_givenName" Label="First name" MaxLength="100" ReadOnly="!CanWrite" />
                <MudTextField @bind-Value="_familyName" Label="Last name" MaxLength="100" ReadOnly="!CanWrite" />
                <MudTextField @bind-Value="_locale" Label="Language" HelperText="A language tag, such as en or tr." MaxLength="16" ReadOnly="!CanWrite" />
                <MudTextField @bind-Value="_pictureUrl" Label="Picture URL" HelperText="An image of the user, such as their avatar." MaxLength="2048" ReadOnly="!CanWrite" />
                <MudTextField @bind-Value="_timeZone" Label="Time zone" HelperText="An IANA name, such as Europe/Istanbul." MaxLength="64" ReadOnly="!CanWrite" />
                @if (CanWrite)
                {
                    <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfileAsync" id="save-profile">Save</MudButton>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined>
                <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>Roles</MudText>
                <MudSelect T="string" Label="Global roles" MultiSelection @bind-SelectedValues="_roles" ReadOnly="!CanWrite"
                           HelperText="Organization roles come with memberships.">
                    @foreach (var role in _globalRoles)
                    {
                        <MudSelectItem T="string" Value="role.Key">@role.Name (@role.Key)</MudSelectItem>
                    }
                </MudSelect>
                @if (CanWrite)
                {
                    <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRolesAsync" id="save-roles">Save roles</MudButton>
                }
            </MudPaper>
        </MudItem>

        @if (CanWrite)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined>
                    <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>Sign-in</MudText>
                    <MudStack Row Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined" OnClick="SendPasswordResetAsync">Send a password reset</MudButton>
                        @if (!user.EmailVerified)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="VerifyEmailAsync" id="verify-email">Mark the email as verified</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" OnClick="ResetMfaAsync">Reset two-factor authentication</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined>
                <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>Connected accounts</MudText>
                @if (_logins.Count == 0)
                {
                    <MudText Typo="Typo.body2">None.</MudText>
                }
                <MudList T="string" Dense>
                    @foreach (var login in _logins)
                    {
                        <MudListItem T="string">
                            <MudStack Row AlignItems="AlignItems.Center">
                                <MudText>@login.ProviderDisplayName</MudText>
                                <MudSpacer />
                                @if (CanWrite)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => UnlinkAsync(login)">Disconnect</MudButton>
                                }
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined id="sessions">
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>Signed in to</MudText>
                    <MudSpacer />
                    @if (CanWrite && _sessions.Count > 0)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="RevokeSessionsAsync">Sign out everywhere</MudButton>
                    }
                </MudStack>
                @if (_sessions.Count == 0)
                {
                    <MudText Typo="Typo.body2">No applications.</MudText>
                }
                <MudList T="string" Dense>
                    @foreach (var session in _sessions)
                    {
                        <MudListItem T="string">
                            <MudStack Row AlignItems="AlignItems.Center">
                                <div>
                                    <MudText>@(session.ClientName ?? session.ClientId ?? "Unknown application")</MudText>
                                    <MudText Typo="Typo.caption">Since <Moment Value="session.CreatedAt" /></MudText>
                                </div>
                                <MudSpacer />
                                @if (CanWrite)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RevokeSessionAsync(session)">Sign out</MudButton>
                                }
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined id="passkeys">
                <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>Passkeys</MudText>
                @if (_passkeys.Count == 0)
                {
                    <MudText Typo="Typo.body2">None.</MudText>
                }
                <MudList T="string" Dense>
                    @foreach (var passkey in _passkeys)
                    {
                        <MudListItem T="string">
                            <MudStack Row AlignItems="AlignItems.Center">
                                <div>
                                    <MudText>@passkey.Name</MudText>
                                    <MudText Typo="Typo.caption">Added <Moment Value="passkey.CreatedAt" />@(passkey.Synced ? ", synced" : string.Empty)</MudText>
                                </div>
                                <MudSpacer />
                                @if (CanWrite)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RemovePasskeyAsync(passkey)">Remove</MudButton>
                                }
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MetadataEditor PublicMetadata="user.PublicMetadata" PrivateMetadata="user.PrivateMetadata" ReadOnly="!CanWrite" OnSave="SaveMetadataAsync" />
        </MudItem>

        @if (Session.Has(SystemPermissions.ApiKeysRead))
        {
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Outlined>
                    <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>API keys</MudText>
                    @if (_apiKeys.Count == 0)
                    {
                        <MudText Typo="Typo.body2">None.</MudText>
                    }
                    <MudList T="string" Dense>
                        @foreach (var key in _apiKeys)
                        {
                            <MudListItem T="string">
                                <MudStack Row AlignItems="AlignItems.Center">
                                    <div>
                                        <MudText>@key.Name <code>@key.Prefix…</code></MudText>
                                        <MudText Typo="Typo.caption">
                                            @if (key.RevokedAt is not null)
                                            {
                                                <span>Revoked <Moment Value="key.RevokedAt" /></span>
                                            }
                                            else
                                            {
                                                <span>Last used <Moment Value="key.LastUsedAt" /></span>
                                            }
                                        </MudText>
                                    </div>
                                    <MudSpacer />
                                    @if (key.RevokedAt is null && Session.Has(SystemPermissions.ApiKeysWrite))
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RevokeKeyAsync(key)">Revoke</MudButton>
                                    }
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
        }

        @if (CanWrite)
        {
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined>
                    <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom>Danger zone</MudText>
                    <MudStack Row Wrap="Wrap.Wrap">
                        @if (user.Status == UserStatus.Suspended)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="ReactivateAsync" id="reactivate">Reactivate</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="SuspendAsync" id="suspend">Suspend</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync" id="delete">Delete</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private UserResponse? _user;
    private bool _notFound;
    private string? _givenName;
    private string? _familyName;
    private string? _locale;
    private string? _pictureUrl;
    private string? _timeZone;
    private IReadOnlyCollection<string> _roles = [];
    private IReadOnlyList<RoleResponse> _globalRoles = [];
    private IReadOnlyList<UserLoginResponse> _logins = [];
    private IReadOnlyList<SessionResponse> _sessions = [];
    private IReadOnlyList<PasskeyResponse> _passkeys = [];
    private IReadOnlyList<ApiKeyResponse> _apiKeys = [];

    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Users", "/admin/users")];

    [Parameter]
    public Guid Id { get; set; }

    private bool CanWrite => Session.Has(SystemPermissions.UsersWrite);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var user = await Operations.RunAsync<GetUserHandler, Result<UserResponse>>(SystemPermissions.UsersRead, handler => handler.HandleAsync(Id, Aborted));
        if (user.IsFailure)
        {
            _notFound = true;
            return;
        }

        Show(user.Value);

        var roles = await Operations.RunAsync<ListRolesHandler, Result<Page<RoleResponse>>>(
            SystemPermissions.UsersRead, handler => handler.HandleAsync(new ListRolesQuery(null, RoleScope.Global, null, 200), Aborted));
        _globalRoles = roles.IsSuccess ? roles.Value.Items : [];

        var logins = await Operations.RunAsync<ListUserLoginsHandler, Result<IReadOnlyList<UserLoginResponse>>>(SystemPermissions.UsersRead, handler => handler.HandleAsync(Id));
        _logins = logins.IsSuccess ? logins.Value : [];

        var sessions = await Operations.RunAsync<ListUserSessionsHandler, Result<IReadOnlyList<SessionResponse>>>(SystemPermissions.UsersRead, handler => handler.HandleAsync(Id, Aborted));
        _sessions = sessions.IsSuccess ? sessions.Value : [];

        var passkeys = await Operations.RunAsync<ListUserPasskeysHandler, Result<IReadOnlyList<PasskeyResponse>>>(SystemPermissions.UsersRead, handler => handler.HandleAsync(Id));
        _passkeys = passkeys.IsSuccess ? passkeys.Value : [];

        if (Session.Has(SystemPermissions.ApiKeysRead))
        {
            var keys = await Operations.RunAsync<ListApiKeysHandler, Result<Page<ApiKeyResponse>>>(
                SystemPermissions.ApiKeysRead, handler => handler.HandleAsync(new ListApiKeysQuery(Id, null, null, 200), Aborted));
            _apiKeys = keys.IsSuccess ? keys.Value.Items : [];
        }
    }

    private void Show(UserResponse user)
    {
        _user = user;
        _givenName = user.GivenName;
        _familyName = user.FamilyName;
        _locale = user.Locale;
        _pictureUrl = user.PictureUrl;
        _timeZone = user.TimeZone;
        _roles = user.Roles;
        _breadcrumbs.RemoveRange(1, _breadcrumbs.Count - 1);
        _breadcrumbs.Add(new BreadcrumbItem(user.Email ?? user.Id.ToString(), href: null, disabled: true));
    }

    private async Task SaveProfileAsync()
    {
        var request = new UpdateUserRequest { GivenName = _givenName, FamilyName = _familyName, Locale = _locale, PictureUrl = _pictureUrl, TimeZone = _timeZone };
        if (await ChangeAsync<UpdateUserHandler, UserResponse>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, request, Aborted), "The profile was saved.") is { } user)
        {
            Show(user);
        }
    }

    private async Task SaveRolesAsync()
    {
        var request = new SetRolesRequest { Roles = [.. _roles] };
        if (await ChangeAsync<SetUserRolesHandler, UserResponse>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, request, Aborted), "The roles were saved.") is { } user)
        {
            Show(user);
        }
    }

    private async Task SaveMetadataAsync(MetadataEditor.MetadataChange change)
    {
        var request = new UpdateUserRequest { PublicMetadata = change.Public, PrivateMetadata = change.Private };
        if (await ChangeAsync<UpdateUserHandler, UserResponse>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, request, Aborted), "The metadata was saved.") is { } user)
        {
            Show(user);
        }
    }

    private Task SendPasswordResetAsync() =>
        ChangeAsync<SendPasswordResetHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, Aborted), "A password reset email is on its way.");

    private async Task VerifyEmailAsync()
    {
        if (await ChangeAsync<VerifyUserEmailHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, Aborted), "The email address is verified."))
        {
            await LoadAsync();
        }
    }

    private async Task ResetMfaAsync()
    {
        if (await ConfirmAsync("Reset two-factor authentication?", "The user's authenticator and recovery codes stop working and their sessions end. They set it up again at their next sign-in if their account requires it.", "Reset"))
        {
            await ChangeAsync<ResetUserMfaHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, Aborted), "Two-factor authentication was reset.");
        }
    }

    private async Task UnlinkAsync(UserLoginResponse login)
    {
        if (await ConfirmAsync($"Disconnect {login.ProviderDisplayName}?", "The user can no longer sign in with this account.", "Disconnect")
            && await ChangeAsync<UnlinkUserLoginHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, login.Provider, Aborted), "The account was disconnected."))
        {
            await LoadAsync();
        }
    }

    private async Task RemovePasskeyAsync(PasskeyResponse passkey)
    {
        if (await ConfirmAsync($"Remove {passkey.Name}?", "The user can no longer sign in with this passkey.", "Remove")
            && await ChangeAsync<RemoveUserPasskeyHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, passkey.Id, Aborted), "The passkey was removed."))
        {
            await LoadAsync();
        }
    }

    private async Task RevokeSessionAsync(SessionResponse session)
    {
        if (await ConfirmAsync($"Sign out of {session.ClientName ?? session.ClientId}?", "The application's tokens stop working, and it has to ask the user to sign in again.", "Sign out")
            && await ChangeAsync<RevokeUserSessionHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, session.Id, Aborted), "The application was signed out."))
        {
            await LoadAsync();
        }
    }

    private async Task RevokeSessionsAsync()
    {
        if (await ConfirmAsync("Sign out everywhere?", "Every application the user signed in to loses its tokens, and their browser sessions end within minutes.", "Sign out everywhere")
            && await ChangeAsync<RevokeUserSessionsHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, Aborted), "The user was signed out everywhere."))
        {
            await LoadAsync();
        }
    }

    private async Task RevokeKeyAsync(ApiKeyResponse key)
    {
        if (await ConfirmAsync($"Revoke {key.Name}?", "The key stops working at once.", "Revoke")
            && await ChangeAsync<RevokeApiKeyHandler>(SystemPermissions.ApiKeysWrite, handler => handler.HandleAsync(key.Id, Aborted), "The key was revoked."))
        {
            await LoadAsync();
        }
    }

    private async Task SuspendAsync()
    {
        if (await ConfirmAsync("Suspend this user?", "They cannot sign in, and every session and token they hold ends.", "Suspend")
            && await ChangeAsync<SuspendUserHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, Aborted), "The user was suspended."))
        {
            await LoadAsync();
        }
    }

    private async Task ReactivateAsync()
    {
        if (await ChangeAsync<ReactivateUserHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, Aborted), "The user was reactivated."))
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        if (await ConfirmAsync("Delete this user?", "The account and its personal data are deleted for good.", "Delete")
            && await ChangeAsync<DeleteUserHandler>(SystemPermissions.UsersWrite, handler => handler.HandleAsync(Id, Aborted), "The user was deleted."))
        {
            Navigation.NavigateTo("/admin/users");
        }
    }
}
