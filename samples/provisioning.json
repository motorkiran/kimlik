{
  "$schema": "../docs/schemas/provisioning.schema.json",
  "permissions": [
    { "key": "invoices:read", "description": "Read invoices" },
    { "key": "invoices:write", "description": "Create invoices" }
  ],
  "roles": [
    {
      "key": "accountant",
      "name": "Accountant",
      "description": "Reads and creates invoices.",
      "permissions": ["invoices:read", "invoices:write"]
    },
    {
      // A custom role may hold system permissions; this one lets the sample API manage users and subscriptions.
      "key": "invoices-backend",
      "name": "Invoices backend",
      "permissions": ["kimlik.users:read", "kimlik.users:write", "kimlik.plans:read", "kimlik.subscriptions:read", "kimlik.subscriptions:write", "kimlik.api_keys:verify"]
    }
  ],
  "features": [
    { "key": "export_pdf", "name": "Invoice export", "type": "boolean" },
    { "key": "max_invoices", "name": "Invoices per user", "type": "limit" }
  ],
  "plans": [
    { "key": "free", "name": "Free", "features": { "export_pdf": false, "max_invoices": 3 } },
    { "key": "pro", "name": "Pro", "features": { "export_pdf": true, "max_invoices": null } }
  ],
  "apiResources": [
    { "scope": "invoices", "audience": "invoices-api", "displayName": "Manage your invoices" }
  ],
  "clients": [
    {
      "clientId": "invoices-spa",
      "displayName": "Invoices",
      "type": "spa",
      "redirectUris": ["http://localhost:5173/"],
      "postLogoutRedirectUris": ["http://localhost:5173/"],
      "scopes": ["openid", "profile", "email", "offline_access", "invoices"]
    },
    {
      "clientId": "invoices-backend",
      "displayName": "Invoices backend",
      "type": "service",
      "scopes": ["kimlik"],
      "roles": ["invoices-backend"],
      // Read from configuration, here the Samples__InvoicesBackendSecret environment variable.
      "clientSecret": "${Samples:InvoicesBackendSecret}"
    }
  ]
}
